ANTHROPIC_API_KEY=
AGENT_BASE_URL=
POSTGRES_DB=<replace with the db to use>
POSTGRES_USER=<replace with some user>
POSTGRES_PASSWORD=<replace with some password>
DATABASE_URL=postgres://<replace with db user>:<replace with db password>@postgres:5432/simple-ai-os
# iam SSO client credentials, used to register a per-tenant iam app during
# provisioning (see web/iam/docs/user-guides and lib/nuxt-iam-client's README)
NUXT_IAM_URL=
NUXT_IAM_CLIENT_ID=
NUXT_IAM_CLIENT_API_SECRET=
# 64-character hex string (32 bytes) - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_TENANT_SECRET_ENCRYPTION_KEY=
